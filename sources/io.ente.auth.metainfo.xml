<?xml version="1.0" encoding="UTF-8"?>
<!-- Curated AppStream metadata for the enteauth COPR rewrap.
     Upstream ships enteauth.appdata.xml with the non-reverse-DNS id
     "enteauth", which fails `appstreamcli validate`
     (cid-desktopapp-is-not-rdns). Content below mirrors upstream, with the
     RDNS id io.ente.auth (matching Icon/StartupWMClass in enteauth.desktop).
     CI patches the <release> version/date on each new upstream release. -->
<component type="desktop-application">
  <id>io.ente.auth</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>Ente Auth</name>
  <summary>2FA app with free end-to-end encrypted backup and sync</summary>
  <description>
    <p>Auth provides end-to-end encrypted cloud backups so you don't have to worry about losing your tokens. Our cryptography has been externally audited.</p>
    <p>Auth has an app for every platform. Mobile, desktop and web. Your codes sync across all your devices, end-to-end encrypted.</p>
    <p>Auth also comes with Offline mode, tags, icons, pins, import/export and more.</p>
  </description>
  <categories>
    <category>Utility</category>
  </categories>
  <developer id="io.ente">
    <name>Ente Developers</name>
  </developer>
  <update_contact>auth@ente.com</update_contact>
  <url type="homepage">https://ente.com/auth</url>
  <url type="vcs-browser">https://github.com/ente/ente</url>
  <launchable type="desktop-id">enteauth.desktop</launchable>
  <provides>
    <binary>enteauth</binary>
  </provides>
  <releases>
    <release version="4.4.25" date="2026-07-30"/>
  </releases>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/ente/ente/main/.github/assets/auth.png</image>
      <caption>Import codes and access your saved 2FA tokens across devices</caption>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#ffffff</color>
    <color type="primary" scheme_preference="dark">#000000</color>
  </branding>
</component>
